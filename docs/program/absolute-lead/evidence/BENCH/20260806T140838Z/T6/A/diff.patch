@@ -0,0 +1,18 @@
+"""Bound a value into a closed interval."""
+
+
+def clamp(value, low, high):
+    """Return `value` bounded into the closed interval [low, high].
+
+    Raises ValueError when `low` > `high`, since that interval is empty.
+
+    >>> clamp(11, 0, 10)
+    10
+    """
+    if low > high:
+        raise ValueError("low must not be greater than high")
+    if value < low:
+        return low
+    if value > high:
+        return high
+    return value
