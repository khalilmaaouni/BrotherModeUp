@@ -0,0 +1,18 @@
+"""Turn a title into a URL-friendly slug."""
+
+import re
+
+_WORD = re.compile(r"[a-z0-9]+")
+
+
+def slugify(title):
+    """Lowercase ``title``, keep only letters and digits, join words with hyphens.
+
+    Every run of characters that is not an ASCII letter or digit is treated as a
+    word separator, so leading, trailing and repeated separators never produce
+    empty or doubled hyphens.
+
+    >>> slugify("  Hello,   World!  ")
+    'hello-world'
+    """
+    return "-".join(_WORD.findall(title.lower()))
