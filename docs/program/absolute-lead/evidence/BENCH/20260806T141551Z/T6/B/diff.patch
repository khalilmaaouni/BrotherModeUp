+"""Bound a value into a closed range."""
+
+
+def clamp(value, low, high):
+    """Return ``value`` bounded into the closed range ``[low, high]``.
+
+    Returns ``low`` when ``value`` is below the range, ``high`` when it is
+    above, and ``value`` itself otherwise.
+
+    Raises:
+        ValueError: if ``low`` is greater than ``high``.
+    """
+    if low > high:
+        raise ValueError("low (%r) must not be greater than high (%r)" % (low, high))
+    if value < low:
+        return low
+    if value > high:
+        return high
+    return value
