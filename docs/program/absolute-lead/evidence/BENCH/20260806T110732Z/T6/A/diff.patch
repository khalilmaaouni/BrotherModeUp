@@ -0,0 +1,14 @@
+"""Turn a title into a URL-friendly slug."""
+
+import re
+
+_WORDS = re.compile(r"[a-z0-9]+")
+
+
+def slugify(title):
+    """Lowercase `title`, keep only letters and digits, join words with "-".
+
+    Any run of characters that are not letters or digits acts as a word
+    separator, and separators never produce empty or repeated hyphens.
+    """
+    return "-".join(_WORDS.findall(title.lower()))
