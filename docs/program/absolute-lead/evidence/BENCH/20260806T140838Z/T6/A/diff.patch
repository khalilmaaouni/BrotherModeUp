+++ b/src/chunk.py
@@ -0,0 +1,23 @@
+"""Split an iterable into fixed-size chunks."""
+
+
+def chunk(items, size):
+    """Yield lists of at most `size` items from `items`, in order.
+
+    The final chunk is short when len(items) is not a multiple of `size`.
+    Raises ValueError when `size` < 1. `items` may be any iterable; it is
+    consumed lazily, one chunk at a time.
+
+    >>> list(chunk([1, 2, 3], 2))
+    [[1, 2], [3]]
+    """
+    if size < 1:
+        raise ValueError("size must be at least 1")
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
