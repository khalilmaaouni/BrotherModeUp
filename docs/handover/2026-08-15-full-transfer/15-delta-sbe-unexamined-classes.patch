+# ---------------------------------------------------------------------------
+# Unexamined test classes: the external review's closing finding was that an
+# all-green summary systematically under-represents how much checking
+# remains, because regression, cross-device, performance, user-experience,
+# and localisation testing sit entirely outside every gate and every
+# receipt. This is a REPORTING-ONLY change: it must never move the exit
+# code, and it must never turn a PASS into a FAIL.
+# ---------------------------------------------------------------------------
+
+class TestUnexaminedClassesNamedOnAllGreen(ReportCase):
+
+    def test_an_all_green_report_names_every_unexamined_class_as_no_data(self):
+        write_json(os.path.join(self.root, ".sbe", "tasks.json"),
+                   tasks_registry([one_task("T01")]))
+        write_json(os.path.join(self.root, ".sbe", "evidence", "T01-receipt.json"),
+                   {"command": "true", "verdict": "PASS"})
+        proc = self.run_once()
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        out = proc.stdout
+        self.assertIn("1 PASS, 0 FAIL, 0 NO-DATA, 0 unverified", out,
+                      "calibration: this must actually be an all-green summary")
+        self.assertIn("NOT EXAMINED", out)
+        self.assertIn("NO-DATA", out)
+        for cls in ("regression", "cross-device", "performance",
+                    "user experience", "localisation"):
+            self.assertIn(cls, out, "the unexamined line must name %r" % cls)
+
+    def test_exit_code_is_unaffected_by_the_unexamined_classes_line(self):
+        write_json(os.path.join(self.root, ".sbe", "tasks.json"),
+                   tasks_registry([one_task("T-FAIL")]))
+        write_json(os.path.join(self.root, ".sbe", "evidence", "T-FAIL-receipt.json"),
+                   {"command": "false", "verdict": "FAIL"})
+        proc = self.run_once()
+        self.assertEqual(proc.returncode, 0,
+                         "a reporter must never fail a build, before or after: %s"
+                         % proc.stderr)
+
+    def test_a_class_named_by_a_receipt_command_is_not_reported_as_unexamined(self):
+        write_json(os.path.join(self.root, ".sbe", "tasks.json"),
+                   tasks_registry([one_task("T-REG",
+                                            verify="pytest tests/test_regression.py")]))
+        write_json(os.path.join(self.root, ".sbe", "evidence", "T-REG-receipt.json"),
+                   {"command": "pytest tests/test_regression.py", "verdict": "PASS"})
+        out = self.run_once().stdout
+        # The regression class has a receipt naming it: it must not appear in
+        # the unexamined-classes line's list of missing classes, even though
+        # the word appears elsewhere in the page too.
+        unexamined_line = [l for l in out.splitlines() if l.startswith("NOT EXAMINED")][0]
+        self.assertNotIn("regression", unexamined_line)
+        for cls in ("cross-device", "performance", "user experience", "localisation"):
+            self.assertIn(cls, unexamined_line)
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=1)
