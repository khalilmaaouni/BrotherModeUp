+"""Turn a title into a url-friendly slug."""
+
+import re
+
+_WORDS = re.compile(r"[a-z0-9]+")
+
+
+def slugify(title):
+    """Lowercase ``title``, keep only letters and digits, join with hyphens.
+
+    Every run of characters that is not an ASCII letter or digit acts as a
+    word break, so punctuation and repeated spaces collapse into a single
+    hyphen and leading or trailing separators disappear.
+
+    Characters outside ASCII (accents, other scripts) are treated as
+    separators rather than kept.
+
+    An empty string comes back for a title with nothing sluggable in it.
+    """
+    return "-".join(_WORDS.findall(title.lower()))
