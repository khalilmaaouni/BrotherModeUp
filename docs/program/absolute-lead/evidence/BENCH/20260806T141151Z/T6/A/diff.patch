+"""chunk(items, size) -> generator of lists of at most `size` items."""
+
+
+def chunk(items, size):
+    """Yield lists of at most `size` items from `items`, preserving order.
+
+    The final chunk may be shorter. Raises ValueError if size < 1. The
+    ValueError is raised eagerly (on call, not on first iteration) so callers
+    see bad arguments immediately.
+    """
+    if size < 1:
+        raise ValueError("size must be >= 1, got %r" % (size,))
+    return _chunk(items, size)
+
+
+def _chunk(items, size):
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
