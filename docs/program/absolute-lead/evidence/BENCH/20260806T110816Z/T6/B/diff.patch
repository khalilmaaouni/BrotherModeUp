+"""Turn a title into a URL-friendly slug."""
+
+
+def slugify(title):
+    """Lowercase ``title``, keep only letters and digits, join words with
+    single hyphens.
+
+    Any run of characters that is not a letter or a digit acts as a word
+    separator. Leading and trailing separators produce no leading or trailing
+    hyphens.
+
+    Raises:
+        TypeError: if ``title`` is not a string.
+    """
+    if not isinstance(title, str):
+        raise TypeError("title must be a string")
+
+    words = []
+    current = []
+    for char in title.lower():
+        if char.isalnum():
+            current.append(char)
+        elif current:
+            words.append("".join(current))
+            current = []
+    if current:
+        words.append("".join(current))
+
+    return "-".join(words)
