+"""Split an iterable into fixed-size batches."""
+
+
+def chunk(items, size):
+    """Yield lists of at most ``size`` items from ``items``, in order.
+
+    Only the final batch may be shorter than ``size``. ``items`` may be any
+    iterable, including a generator; it is consumed lazily, one batch at a time.
+
+    Raises:
+        ValueError: if ``size`` is less than 1.
+    """
+    if size < 1:
+        raise ValueError("size must be at least 1, got %r" % (size,))
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
