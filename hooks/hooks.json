{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/tools/bm_sessionstart.sh\"",
            "timeout": 30,
            "statusMessage": "Loading your project memory"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_telemetry.py\" outcomes-append",
            "timeout": 30,
            "statusMessage": "Saving the session record"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=$(cat); printf %s \"$p\" | python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_telemetry.py\" stop-warn; printf %s \"$p\" | python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_lead.py\" watchdog --tick; printf %s \"$p\" | python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_view.py\" render --if-stale; printf %s \"$p\" | python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_view.py\" alert --tick; python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_handover.py\" owed 2>/dev/null || true'",
            "timeout": 30,
            "statusMessage": "Checking for unfinished work"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=$(cat); printf %s \"$p\" | python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_autosave.py\" precompact; printf %s \"$p\" | python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_telemetry.py\" precompact-brief'",
            "timeout": 60,
            "statusMessage": "Saving your work before the context is condensed"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_fence_hook.py\"",
            "timeout": 10,
            "statusMessage": "Checking that only one worker edits this file"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_bash_audit.py\" pre",
            "timeout": 10,
            "statusMessage": "Noting the fenced files before this shell command runs"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_session_cap.py\"",
            "timeout": 10,
            "statusMessage": "Checking how many sessions are already running"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/tools/bm_bash_audit.py\" post",
            "timeout": 15,
            "statusMessage": "Checking whether that shell command crossed a fence"
          }
        ]
      }
    ]
  }
}
