+"""Bound a value into a closed range."""
+
+
+def clamp(value, low, high):
+    """Return ``value`` bounded into ``[low, high]``.
+
+    Values below ``low`` come back as ``low``, values above ``high`` come back
+    as ``high``, and anything in between is returned unchanged.
+
+    Raises:
+        ValueError: if ``low`` is greater than ``high``.
+    """
+    if low > high:
+        raise ValueError("low must not be greater than high")
+    if value < low:
+        return low
+    if value > high:
+        return high
+    return value
