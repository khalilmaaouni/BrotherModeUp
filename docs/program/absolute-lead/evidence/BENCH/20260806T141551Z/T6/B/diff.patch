+import unittest
+
+from src.slugify import slugify
+
+
+class TestSlugify(unittest.TestCase):
+    def test_lowercases_and_joins_words(self):
+        self.assertEqual(slugify("Hello World"), "hello-world")
+
+    def test_keeps_digits(self):
+        self.assertEqual(slugify("Top 10 Songs"), "top-10-songs")
+
+    def test_collapses_runs_of_separators(self):
+        self.assertEqual(slugify("a   b---c"), "a-b-c")
+
+    def test_strips_leading_and_trailing_separators(self):
+        self.assertEqual(slugify("  --Hello, World!  "), "hello-world")
+
+    def test_drops_punctuation_inside_words(self):
+        self.assertEqual(slugify("don't stop"), "don-t-stop")
+
+    def test_empty_and_separator_only_inputs(self):
+        self.assertEqual(slugify(""), "")
+        self.assertEqual(slugify("!!! ???"), "")
+
+    def test_already_a_slug_is_unchanged(self):
+        self.assertEqual(slugify("hello-world"), "hello-world")
+
+    def test_non_string_raises_type_error(self):
+        with self.assertRaises(TypeError):
+            slugify(None)
+
+
+if __name__ == "__main__":
+    unittest.main()
