+"""Unit tests for :func:`src.reverse_words.reverse_words`."""
+
+import unittest
+
+from src.reverse_words import reverse_words
+
+
+class ReverseWordsTest(unittest.TestCase):
+    def test_reverses_a_simple_sentence(self):
+        self.assertEqual(reverse_words("one two three"), "three two one")
+
+    def test_single_word_is_unchanged(self):
+        self.assertEqual(reverse_words("solo"), "solo")
+
+    def test_empty_string_gives_empty_string(self):
+        self.assertEqual(reverse_words(""), "")
+
+    def test_whitespace_only_gives_empty_string(self):
+        self.assertEqual(reverse_words("   \t\n "), "")
+
+    def test_runs_of_spaces_collapse_to_one(self):
+        self.assertEqual(reverse_words("one    two"), "two one")
+
+    def test_leading_and_trailing_whitespace_is_dropped(self):
+        self.assertEqual(reverse_words("  one two  "), "two one")
+
+    def test_tabs_and_newlines_separate_words(self):
+        self.assertEqual(reverse_words("one\ttwo\nthree"), "three two one")
+
+    def test_punctuation_travels_with_its_word(self):
+        self.assertEqual(reverse_words("hello, world!"), "world! hello,")
+
+    def test_repeated_words_keep_their_count(self):
+        self.assertEqual(reverse_words("a b a"), "a b a")
+
+    def test_input_string_is_not_mutated(self):
+        text = "one two"
+        reverse_words(text)
+        self.assertEqual(text, "one two")
+
+
+if __name__ == "__main__":
+    unittest.main()
