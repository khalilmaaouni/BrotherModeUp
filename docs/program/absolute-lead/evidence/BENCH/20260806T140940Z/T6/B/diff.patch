@@ -0,0 +1,33 @@
+import unittest
+
+from src.clamp import clamp
+
+
+class TestClamp(unittest.TestCase):
+    def test_value_inside_range_is_unchanged(self):
+        self.assertEqual(clamp(5, 0, 10), 5)
+
+    def test_value_below_low_returns_low(self):
+        self.assertEqual(clamp(-3, 0, 10), 0)
+
+    def test_value_above_high_returns_high(self):
+        self.assertEqual(clamp(42, 0, 10), 10)
+
+    def test_boundaries_are_included(self):
+        self.assertEqual(clamp(0, 0, 10), 0)
+        self.assertEqual(clamp(10, 0, 10), 10)
+
+    def test_single_point_range(self):
+        self.assertEqual(clamp(7, 3, 3), 3)
+
+    def test_floats_and_negatives(self):
+        self.assertEqual(clamp(-0.5, -1.0, 1.0), -0.5)
+        self.assertEqual(clamp(-9, -5, -1), -5)
+
+    def test_low_greater_than_high_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            clamp(5, 10, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
