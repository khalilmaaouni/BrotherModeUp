+class TestStalenessClock(unittest.TestCase):
+    """The staleness clock: an OPTIONAL "answered_head" field on 00-intake.json,
+    the commit HEAD was at when this dossier's intake was answered. Separate
+    from `binding.head` (TestDossierBindingScenario23 above), which is an
+    exact-match convergence check and FAILs on ANY drift; this one is
+    distance-tolerant and never FAILs, only NO-DATA or PASS -- a stale design
+    is an unknown, not a defect. Every fixture here builds a REAL git
+    repository and runs the real tools/sbe_design.py, matching
+    TestDossierBindingScenario23's own pattern (fixtures for the same file,
+    the same seam: reused here rather than re-declared).
+    """
+
+    DESIGN = os.path.join(HERE, "sbe_design.py")
+    B = TestDossierBindingScenario23
+
+    def setUp(self):
+        self.dir = tempfile.mkdtemp()
+        self.repo = os.path.join(self.dir, "repo")
+        os.makedirs(self.repo)
+        self._git("init", "-q")
+        self._git("config", "user.email", "dana@example.invalid")
+        self._git("config", "user.name", "Dana Author")
+        self._git("config", "commit.gpgsign", "false")
+
+    def tearDown(self):
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+    def _git(self, *args):
+        out = subprocess.run(["git"] + list(args), cwd=self.repo, capture_output=True, text=True)
+        if out.returncode != 0:
+            raise AssertionError("git %s failed in %s: %s" % (" ".join(args), self.repo, out.stderr))
+        return out.stdout.strip()
+
+    def _write(self, rel, body):
+        path = os.path.join(self.repo, rel)
+        directory = os.path.dirname(path)
+        if directory and not os.path.isdir(directory):
+            os.makedirs(directory)
+        with io.open(path, "w", encoding="utf-8") as fh:
+            fh.write(body)
+
+    def _commit_dossier(self, extra_intake=None, message="add dossier"):
+        intake = {"tier": "T1", "answers": self.B.ANSWERS}
+        if extra_intake:
+            intake.update(extra_intake)
+        self._write("01-purpose.md", self.B.PURPOSE)
+        self._write("08-behaviour.md", self.B.BEHAVIOUR)
+        self._write("00-intake.json", json.dumps(intake, indent=2, sort_keys=True))
+        self._git("add", "-A")
+        self._git("commit", "-qm", message)
+        return self._git("rev-parse", "HEAD")
+
+    def _run_design(self):
+        out = subprocess.run([sys.executable, self.DESIGN, self.repo],
+                             capture_output=True, text=True)
+        return out.stdout + out.stderr
+
+    def _verdict(self, text, name):
+        for line in text.splitlines():
+            parts = line.split()
+            if len(parts) >= 2 and parts[0] == name:
+                return parts[1], line
+        return None, "NO VERDICT LINE for %r in:\n%s" % (name, text)
+
+    def test_a_recorded_commit_far_behind_head_is_stale_no_data(self):
+        answered = self._commit_dossier()
+        for i in range(60):
+            self._write("churn%d.txt" % i, "churn %d\n" % i)
+            self._git("add", "-A")
+            self._git("commit", "-qm", "churn %d" % i)
+        self._write("00-intake.json", json.dumps(
+            {"tier": "T1", "answers": self.B.ANSWERS, "answered_head": answered},
+            indent=2, sort_keys=True))
+        verdict, line = self._verdict(self._run_design(), "staleness")
+        self.assertEqual(verdict, "NO-DATA", line)
+        self.assertIn("stale-since", line)
+        self.assertIn(answered[:12], line)
+
+    def test_no_recorded_commit_is_no_data_naming_the_absence(self):
+        self._commit_dossier()
+        verdict, line = self._verdict(self._run_design(), "staleness")
+        self.assertEqual(verdict, "NO-DATA", line)
+        self.assertIn("no commit its intake was answered against", line)
+
+    def test_a_current_dossier_is_unaffected(self):
+        head = self._commit_dossier()
+        before = self._verdict(self._run_design(), "artifacts")[1]
+        # Left UNCOMMITTED, same as TestDossierBindingScenario23._bind: HEAD
+        # stays exactly at `head`, so this isolates "the field was added" from
+        # "the tree moved on".
+        self._write("00-intake.json", json.dumps(
+            {"tier": "T1", "answers": self.B.ANSWERS, "answered_head": head},
+            indent=2, sort_keys=True))
+        out = self._run_design()
+        stale_verdict, stale_line = self._verdict(out, "staleness")
+        after = self._verdict(out, "artifacts")[1]
+        self.assertEqual(stale_verdict, "PASS", stale_line)
+        self.assertIn(head[:12], stale_line)
+        self.assertEqual(before, after,
+                         "adding answered_head to a current dossier must not move the "
+                         "artifacts check's own verdict line:\nbefore: %r\nafter:  %r"
+                         % (before, after))
+
+
