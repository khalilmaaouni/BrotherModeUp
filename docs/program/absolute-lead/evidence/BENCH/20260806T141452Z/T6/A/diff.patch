+import unittest
+
+from src.chunk import chunk
+
+
+class ChunkTest(unittest.TestCase):
+    def test_exact_multiple(self):
+        self.assertEqual(list(chunk([1, 2, 3, 4], 2)), [[1, 2], [3, 4]])
+
+    def test_last_chunk_is_short(self):
+        self.assertEqual(list(chunk([1, 2, 3], 2)), [[1, 2], [3]])
+
+    def test_size_larger_than_input(self):
+        self.assertEqual(list(chunk([1, 2], 5)), [[1, 2]])
+
+    def test_size_one(self):
+        self.assertEqual(list(chunk("abc", 1)), [["a"], ["b"], ["c"]])
+
+    def test_empty_input_yields_nothing(self):
+        self.assertEqual(list(chunk([], 3)), [])
+
+    def test_accepts_any_iterable_and_is_lazy(self):
+        self.assertEqual(list(chunk(iter(range(5)), 2)), [[0, 1], [2, 3], [4]])
+
+    def test_size_below_one_raises_eagerly(self):
+        for bad in (0, -1):
+            with self.assertRaises(ValueError):
+                chunk([1, 2, 3], bad)
+
+
+if __name__ == "__main__":
+    unittest.main()
