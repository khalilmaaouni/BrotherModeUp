+# STALENESS CLOCK: `binding.head` above answers a narrower question ("do these
+# artifact BYTES still match what was bound"), and answers it strictly -- any
+# drift at all, even one unrelated later commit, is a FAIL demanding a
+# deliberate re-bind (tools/test_sbe.py's test_bound_then_head_moved_fails_by_name).
+# That is the convergence check the module docstring means by "protects the
+# design from the code". Nothing above asks the different question the
+# architecture review raised: is the INTENTION this dossier was answered
+# against still recent, or did the world move on two months ago without
+# anyone coming back to say so. That question needs a DISTANCE-tolerant
+# answer, not an exact-match one, so it is not layered onto `binding.head`
+# (doing so would turn any ordinary later commit into a FAIL here too, which
+# is not what staleness means and would break the test above). It is a
+# second, independent, OPTIONAL key at the same place every other piece of
+# dossier-level metadata already lives -- 00-intake.json, sibling to tier,
+# answers and binding -- so no new file format is introduced:
+#   "answered_head": "<40-hex commit id>"
+# the commit HEAD was at when this dossier's intake was answered. Absent
+# (every dossier written before this field existed), it is NO-DATA naming
+# the absence, never a PASS: a dossier predating this feature must not read
+# as fresh just because nothing was recorded.
+STALE_DISTANCE = 50
+# Default distance, in first-parent commits. Small enough that a same-day run
+# of follow-up commits never trips it; large enough that a dossier answered
+# for a direction abandoned weeks back reads as an unknown rather than
+# sitting green forever. Also bounds the walk below to at most
+# STALE_DISTANCE + 1 loose-object reads, regardless of how long the
+# repository's real history is.
+
+
+def _read_commit_object(git_dir, sha):
+    """The raw decompressed body of a loose commit object, or None.
+
+    Reads ONLY loose objects, the same gap `_object_exists` already names: a
+    commit old enough to have been folded into a pack by a housekeeping `gc`
+    is invisible here, and the caller reports NO-DATA rather than guessing at
+    its parent.
+    """
+    path = os.path.join(git_dir, "objects", sha[:2], sha[2:])
+    try:
+        raw = open(path, "rb").read()
+    except OSError:
+        return None  # sbe: allow-silent an unreadable git object here is exactly the NO-DATA the staleness check then reports by name; nothing is dropped, the absence becomes the verdict
+    try:
+        data = zlib.decompress(raw)
+    except zlib.error:
+        return None  # sbe: allow-silent a corrupt loose object reads as unresolvable, not as a crash
+    nul = data.find(b"\x00")
+    if nul == -1 or not data[:nul].startswith(b"commit "):
+        return None
+    return data[nul + 1:]
+
+
+def _first_parent(git_dir, sha):
+    """The single FIRST `parent` line of commit `sha`, or None: a root commit
+    with no parent, or a commit this tree cannot read.
+
+    Only the first parent is followed, not every parent a merge commit
+    carries: a dossier bound on a side branch that later merged in can
+    undercount its distance from HEAD along the branch that merged it. That
+    is a deliberate ponytail simplification (a first-parent chain, cheap and
+    bounded), not a correctness proof; widen it to a full graph walk if a
+    real staleness case is ever missed this way.
+    """
+    body = _read_commit_object(git_dir, sha)
+    if body is None:
+        return None
+    for line in body.split(b"\n"):
+        if not line:
+            break  # blank line ends the header block; no parent line found before it
+        if line.startswith(b"parent "):
+            candidate = line[len(b"parent "):].strip().decode("ascii", "replace")
+            return candidate if _SHA1_RE.match(candidate) else None
+    return None
+
+
+def check_staleness(root):
+    """(verdict, evidence) for the OPTIONAL "answered_head" field of
+    00-intake.json.
+
+    No problem to report (folded into a PASS by the caller's sentence) when
+    that commit IS the current head or is within STALE_DISTANCE first-parent
+    commits of it. NO-DATA, never FAIL, once history has moved further than
+    that: a stale design is an unknown, not a defect, and this check must
+    never block a run over it. NO-DATA with a different reason when no commit
+    was ever recorded, so a dossier written before this field existed reads
+    as unknown rather than fresh.
+    """
+    problem = read_problem(root, INTAKE)
+    if problem:
+        return "NO-DATA", ("%s is %s, so no recorded commit can be read for staleness"
+                           % (INTAKE, problem))
+    intake = read(root, INTAKE)
+    if intake is None:
+        return "NO-DATA", ("no 00-intake.json; nothing here records the commit this dossier's "
+                           "intake was answered against")
+    try:
+        data = json.loads(intake)
+    except ValueError:
+        return "NO-DATA", "00-intake.json is not valid JSON, so no recorded commit can be read"
+    if not isinstance(data, dict):
+        return "NO-DATA", "00-intake.json is not a JSON object, so no recorded commit can be read"
+    head = data.get("answered_head")
+    if not isinstance(head, str) or not _SHA1_RE.match(head):
+        return "NO-DATA", ("00-intake.json records no commit its intake was answered against (no "
+                           "40-character answered_head); a dossier predating this field must read "
+                           "as unknown, never as fresh")
+    git_dir = _git_dir(root)
+    current = _resolve_head(git_dir) if git_dir else None
+    if current is None:
+        return "NO-DATA", ("answered_head names %s but the current head could not be read from "
+                           "this tree (no readable git metadata above %s), so staleness cannot be "
+                           "measured either way" % (head[:12], root))
+    if head == current:
+        return "PASS", "answered_head %s is the current head" % head[:12]
+    cur = current
+    for hops in range(1, STALE_DISTANCE + 1):
+        parent = _first_parent(git_dir, cur)
+        if parent is None:
+            return "NO-DATA", ("answered_head %s could not be confirmed within %d first-parent "
+                               "commit(s) of the current head %s: history ran out (a root commit, "
+                               "or an unreadable or packed object) before it was found, so "
+                               "distance cannot be measured either way" % (head[:12], STALE_DISTANCE, current[:12]))
+        if parent == head:
+            return "PASS", ("answered_head %s is %d commit(s) behind the current head %s, inside "
+                            "the %d-commit staleness window"
+                            % (head[:12], hops, current[:12], STALE_DISTANCE))
+        cur = parent
+    return "NO-DATA", ("answered_head %s is more than %d first-parent commit(s) behind the current "
+                       "head %s: stale-since %s, an unknown about whether this design still "
+                       "matches the intention it was answered for, not a defect, so it never "
+                       "blocks and is never counted as a pass"
+                       % (head[:12], STALE_DISTANCE, current[:12], head[:12]))
+
