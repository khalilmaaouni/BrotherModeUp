@@ -0,0 +1,25 @@
+"""Split a sequence of items into fixed-size batches."""
+
+
+def _batches(items, size):
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
+
+
+def chunk(items, size):
+    """Yield lists of at most ``size`` items from ``items``, in order.
+
+    The final list is short when the items do not divide evenly. Raises
+    ValueError when ``size`` is less than 1. The check runs before any
+    iteration begins, so a bad size fails at the call rather than on the
+    first ``next()``.
+    """
+    if size < 1:
+        raise ValueError("size must be at least 1")
+    return _batches(items, size)
