# Live per-user state never belongs in the shared repo; copy STATE.template.md
# into your projects instead.
STATE.md
# Same reason: the work registry records real working paths, which can be
# home directories or client and project names on someone's machine.
threads/
.DS_Store
*.bak*
__pycache__/
.superpowers/
# Build artifacts from `uv build` or `python3 -m build`. They must never be
# committed and they must never be left lying around either: scripts/
# verify-install.sh walks the tree and fails on any entry the manifest does
# not name, so a forgotten build/ directory makes a clean checkout look
# tampered with. See docs/PACKAGING.md.
build/
dist/
*.egg-info/
