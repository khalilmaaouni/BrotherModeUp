@@ -0,0 +1,17 @@
+"""Turn a title into a URL-friendly slug."""
+
+import re
+
+_WORDS = re.compile(r"[a-z0-9]+")
+
+
+def slugify(title):
+    """Lowercase ``title``, keep letters and digits, join words with hyphens.
+
+    Any run of characters that is not a letter or a digit separates words.
+    Leading and trailing separators produce no leading or trailing hyphens,
+    and no hyphen is ever doubled.
+    """
+    if not isinstance(title, str):
+        raise TypeError("title must be a string")
+    return "-".join(_WORDS.findall(title.lower()))
