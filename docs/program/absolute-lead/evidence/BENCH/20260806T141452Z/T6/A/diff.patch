+"""Bound a value into an inclusive range."""
+
+
+def clamp(value, low, high):
+    """Return ``value`` bounded into ``[low, high]``.
+
+    Raises ValueError when ``low`` is greater than ``high``.
+
+    >>> clamp(11, 0, 10)
+    10
+    """
+    if low > high:
+        raise ValueError("low (%r) must not be greater than high (%r)" % (low, high))
+    if value < low:
+        return low
+    if value > high:
+        return high
+    return value
