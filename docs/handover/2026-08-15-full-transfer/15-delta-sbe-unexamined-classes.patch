@@ -101,12 +109,59 @@ def summarize(root):
             % (len(tasks), passed, failed, no_data, unverified))
 
 
+# The classes of testing that sit entirely outside this project's whole
+# evidence chain (intake, verification plan, gates, receipts): every one of
+# them is anchored on numbered acceptance criteria, and none of these five
+# classes is a criterion any gate here checks. Named because the external
+# review's closing finding was exactly this: a green gate under-represents
+# how much checking remains, so a reviewer accepting against numbered
+# criteria is never told that regression, cross-device, performance,
+# user-experience, and localisation/translated-copy testing were never in
+# scope. One list, kept here only, so it is never scattered or restated.
+UNEXAMINED_CLASSES = (
+    ("regression", ("regression",)),
+    ("cross-device", ("cross-device", "cross device")),
+    ("performance", ("performance",)),
+    ("user experience", ("user experience", "usability")),
+    ("localisation or translated copy", ("localisation", "localization", "translat")),
+)
+
+
+def unexamined_classes_line(report_text):
+    """The NOT EXAMINED line: every class from UNEXAMINED_CLASSES whose
+    keywords do not appear anywhere in `report_text` (the SUMMARY plus the
+    full A1 one-pager: every task id, command, and verdict this run
+    produced) is named as NO-DATA, because this project's own vocabulary
+    treats NO-DATA as "nothing was examined", never a euphemism for a pass.
+
+    A keyword hit is read only as "some receipt or behaviour row mentions
+    this class"; it is never treated as proof the class was actually run,
+    so a class WITH a hit is simply left off this list rather than being
+    claimed as covered. This is a text scan over evidence already rendered
+    by onepager.render and summarize, not a new verdict: it adds no PASS,
+    FAIL, or exit code of its own."""
+    lowered = report_text.lower()
+    missing = [name for name, keywords in UNEXAMINED_CLASSES
+              if not any(kw in lowered for kw in keywords)]
+    if missing:
+        return ("NOT EXAMINED (NO-DATA): %s. This report's evidence chain is "
+                "acceptance-criteria tasks and receipts only; these classes are "
+                "never gated here, named so an all-green SUMMARY is never read "
+                "as full coverage." % ", ".join(missing))
+    return ("NOT EXAMINED: every class this line tracks (regression, "
+            "cross-device, performance, user experience, localisation or "
+            "translated copy) is mentioned somewhere in this report's own "
+            "text. A text match is not proof any of them actually ran.")
+
+
 def build_report(root):
-    """The full report text: the SUMMARY line, a blank line, then the A1
-    one-pager verbatim (via onepager.render, never re-rendered here)."""
+    """The full report text: the SUMMARY line, the NOT EXAMINED line (see
+    `unexamined_classes_line`), a blank line, then the A1 one-pager verbatim
+    (via onepager.render, never re-rendered here)."""
     summary = summarize(root)
     page_lines = onepager.render(root)
-    lines = [summary, ""] + page_lines
+    unexamined = unexamined_classes_line("\n".join([summary] + page_lines))
+    lines = [summary, unexamined, ""] + page_lines
     return "\n".join(one_line(l) if l else "" for l in lines) + "\n"
 
 
