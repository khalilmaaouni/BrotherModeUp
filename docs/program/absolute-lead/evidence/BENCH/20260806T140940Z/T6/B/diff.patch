+++ b/src/clamp.py
@@ -0,0 +1,16 @@
+"""Bound a value into a closed range."""
+
+
+def clamp(value, low, high):
+    """Return ``value`` bounded into ``[low, high]``.
+
+    Raises ValueError when ``low`` is greater than ``high``, because such a
+    range is empty and no answer would be correct.
+    """
+    if low > high:
+        raise ValueError("low must not be greater than high")
+    if value < low:
+        return low
+    if value > high:
+        return high
+    return value
