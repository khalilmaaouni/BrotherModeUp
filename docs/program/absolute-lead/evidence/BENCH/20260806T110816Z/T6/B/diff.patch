+"""Split an iterable into fixed-size lists."""
+
+
+def chunk(items, size):
+    """Yield lists of at most ``size`` items from ``items``, in order.
+
+    The final list may be shorter than ``size``. An empty input yields
+    nothing.
+
+    Raises:
+        ValueError: if ``size < 1``. The check runs before any item is read,
+            so it is raised on the call itself rather than on first
+            iteration.
+    """
+    if size < 1:
+        raise ValueError("size must be at least 1")
+    return _chunk(items, size)
+
+
+def _chunk(items, size):
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
