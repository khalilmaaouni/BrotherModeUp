+"""Split an iterable into fixed-size chunks."""
+
+
+def chunk(items, size):
+    """Yield lists of at most `size` items from `items`, in order.
+
+    The final chunk is short when `items` does not divide evenly. Raises
+    ValueError when `size` < 1; the check happens eagerly, on the call, not
+    on the first iteration of the generator.
+    """
+    if size < 1:
+        raise ValueError("size must be >= 1, got %r" % (size,))
+    return _chunk(items, size)
+
+
+def _chunk(items, size):
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
