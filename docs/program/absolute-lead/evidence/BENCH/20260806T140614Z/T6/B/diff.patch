+"""Split a sequence of items into batches."""
+
+
+def chunk(items, size):
+    """Yield lists of at most ``size`` items from ``items``, in order.
+
+    The last batch is short when the items do not divide evenly. An empty
+    input yields nothing at all.
+
+    Raises ``ValueError`` when ``size < 1``. The check happens as soon as
+    ``chunk`` is called, not on the first item pulled out, so a bad size is
+    reported at the point of the mistake.
+    """
+    if size < 1:
+        raise ValueError("size must be at least 1, got %r" % (size,))
+    return _chunks(items, size)
+
+
+def _chunks(items, size):
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
