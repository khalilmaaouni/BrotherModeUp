@@ -0,0 +1,15 @@
+"""slugify(title) -> URL-friendly slug."""
+
+import re
+
+_WORD_RE = re.compile(r"[a-z0-9]+")
+
+
+def slugify(title):
+    """Lowercase `title`, keep only letters and digits, join words with '-'.
+
+    Any run of characters that is not a letter or digit acts as a word
+    separator. Leading/trailing separators produce no leading/trailing
+    hyphens. An input with no letters or digits yields an empty string.
+    """
+    return "-".join(_WORD_RE.findall(str(title).lower()))
