@@ -0,0 +1,17 @@
+"""Turn a title into a URL-friendly slug."""
+
+import re
+
+_KEEP = re.compile(r"[a-z0-9]+")
+
+
+def slugify(title):
+    """Lowercase ``title``, keep letters and digits, join words with hyphens.
+
+    Any run of characters that is not a letter or digit separates words, so
+    ``"Hello, World!"`` becomes ``"hello-world"``. Leading and trailing
+    separators are dropped, and separators never double up.
+    """
+    if not isinstance(title, str):
+        raise TypeError("title must be a string")
+    return "-".join(_KEEP.findall(title.lower()))
