--- /dev/null
+++ b/src/test_is_palindrome.py
@@ -0,0 +1,57 @@
+"""Unit tests for :func:`src.is_palindrome.is_palindrome`."""
+
+import unittest
+
+from src.is_palindrome import is_palindrome
+
+
+class IsPalindromeTest(unittest.TestCase):
+    def test_simple_palindrome(self):
+        self.assertTrue(is_palindrome("racecar"))
+
+    def test_simple_non_palindrome(self):
+        self.assertFalse(is_palindrome("python"))
+
+    def test_case_is_ignored(self):
+        self.assertTrue(is_palindrome("RaceCar"))
+
+    def test_punctuation_and_spaces_are_ignored(self):
+        self.assertTrue(is_palindrome("A man, a plan, a canal: Panama"))
+
+    def test_non_palindrome_with_punctuation(self):
+        self.assertFalse(is_palindrome("Hello, world!"))
+
+    def test_digits_count_as_content(self):
+        self.assertTrue(is_palindrome("12321"))
+
+    def test_digits_are_not_ignored(self):
+        # "abba" alone is a palindrome, so a lone digit must break it.
+        self.assertTrue(is_palindrome("abba"))
+        self.assertFalse(is_palindrome("1abba"))
+
+    def test_letters_and_digits_mixed(self):
+        self.assertTrue(is_palindrome("A1, b, 1a"))
+
+    def test_empty_string_is_a_palindrome(self):
+        self.assertTrue(is_palindrome(""))
+
+    def test_string_of_only_punctuation_is_a_palindrome(self):
+        self.assertTrue(is_palindrome(",.!? -"))
+
+    def test_single_character_is_a_palindrome(self):
+        self.assertTrue(is_palindrome("x"))
+
+    def test_even_length_palindrome(self):
+        self.assertTrue(is_palindrome("abba"))
+
+    def test_near_miss_differs_at_the_ends(self):
+        self.assertFalse(is_palindrome("abca"))
+
+    def test_input_string_is_not_mutated(self):
+        text = "Racecar!"
+        is_palindrome(text)
+        self.assertEqual(text, "Racecar!")
+
+
+if __name__ == "__main__":
+    unittest.main()
