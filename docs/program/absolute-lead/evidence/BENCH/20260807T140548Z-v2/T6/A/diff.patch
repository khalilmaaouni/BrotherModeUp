+import unittest
+
+from src.slugify import slugify
+
+
+class SlugifyTest(unittest.TestCase):
+    def test_lowercases(self):
+        self.assertEqual(slugify("HELLO"), "hello")
+
+    def test_joins_words_with_single_hyphen(self):
+        self.assertEqual(slugify("hello world"), "hello-world")
+
+    def test_collapses_runs_of_separators(self):
+        self.assertEqual(slugify("hello   ---  world"), "hello-world")
+
+    def test_drops_punctuation(self):
+        self.assertEqual(slugify("Hello, World!"), "hello-world")
+
+    def test_keeps_digits(self):
+        self.assertEqual(slugify("Top 10 Songs"), "top-10-songs")
+
+    def test_strips_leading_and_trailing_separators(self):
+        self.assertEqual(slugify("  --Hello--  "), "hello")
+
+    def test_empty_string(self):
+        self.assertEqual(slugify(""), "")
+
+    def test_all_separators_gives_empty_string(self):
+        self.assertEqual(slugify("!!! ???"), "")
+
+    def test_already_a_slug_is_unchanged(self):
+        self.assertEqual(slugify("hello-world-2"), "hello-world-2")
+
+
+if __name__ == "__main__":
+    unittest.main()
