+def _strict_provenance():
+    """True when the operator asked this run to accept only build-system
+    evidence. Read from sys.argv here rather than threaded through
+    sbe_checks.run_guarded, which passes a gate exactly one argument (the
+    root) and is another lane's file; the module's own __main__ handler
+    already reads `--strict` from sys.argv the same way."""
+    return PROVENANCE_FLAG in sys.argv
+
+
+def _producer_problem(d, rel):
+    """(fail sentence, no-producer sentence) for one receipt's `producer`
+    field under --strict-provenance. Exactly one of the two is non-empty, or
+    neither is and the receipt's provenance is accepted.
+
+    THE DEFECT THIS CLOSES: `gate_ran` graded the SHAPE of a receipt (a name,
+    a zero exit, a positive duration, a headCommit that binds) and never asked
+    WHERE it came from, so a file typed by hand cleared the gate exactly as
+    well as one an automated build produced. The reviewer's own operating rule
+    is the fix: trust evidence the build system produced, not evidence
+    produced on somebody's laptop.
+
+    The accepted shapes, and nothing else:
+      "local"                                a run on somebody's machine. An
+                                             honest answer, and not what this
+                                             flag accepts.
+      {"ci": <system>, "runId": <id>}        a build system naming itself and
+                                             the run this receipt came out of.
+    A receipt carrying NO producer field at all is neither: it is a receipt
+    written before this field existed, and this project's rule is that absent
+    evidence is never a pass and never a block, so it reports NO-DATA. What is
+    NOT claimed: nothing here resolves the run id against any build system, so
+    this refuses a receipt that ADMITS it was made locally and cannot refuse
+    one that lies. Resolving the id in CI is the control that would; this is
+    the honest half that needs no network.
+    """
+    if PRODUCER not in d:
+        return "", ("%s: records no %s, so where it came from is unknown; a receipt written "
+                    "before this field existed is not a laptop receipt and not a build one"
+                    % (rel, PRODUCER))
+    p = d.get(PRODUCER)
+    if isinstance(p, str):
+        if p.strip().lower() == LOCAL_PRODUCER:
+            return ("%s: %s is %r, and this run accepts only evidence a build system produced"
+                    % (rel, PRODUCER, p), "")
+        return ("%s: %s is the string %r; the only string this field accepts is %r, and a build "
+                "system names itself as {\"ci\": ..., \"runId\": ...}"
+                % (rel, PRODUCER, p, LOCAL_PRODUCER), "")
+    if not isinstance(p, dict):
+        return ("%s: %s is %s, not a string or an object naming the build system and its run"
+                % (rel, PRODUCER, type(p).__name__), "")
+    ci, run_id = answered(p.get("ci")), answered(p.get("runId"))
+    if ci is None or run_id is None:
+        return ("%s: %s names no build system and run (ci=%r, runId=%r); a producer object has "
+                "to say which system ran it and which run it was"
+                % (rel, PRODUCER, p.get("ci"), p.get("runId")), "")
+    return "", ""
+
+
+# A Proof cell names a check when it names something runnable: a path-shaped
+# token, which is how the behaviour tables in this repository actually write
+# one ("python3 tools/test_sbe_status.py, extended with ..."). A cell of free
+# prose ("Manual check: place a first order and confirm ...") names nothing a
+# receipt could carry, and is counted as unmatchable rather than credited as
+# satisfied, because a rule nobody automated is not a rule that ran.
+_PROOF_CHECK = re.compile(r"[A-Za-z0-9_.@-]*/[A-Za-z0-9_.@/-]*[A-Za-z0-9_-]\.[A-Za-z0-9]+")
+
+
+def _plan_rows(root, receipt_path):
+    """(rows, source, problem) for the behaviour table governing one receipt:
+    the nearest 08-behaviour.md at or above the receipt's own directory,
+    inside root. rows is None when there is none anywhere on that path.
+
+    The parser is sbe_design's own `_behaviour_rows`, imported rather than
+    re-written: two parsers of one format drifting apart is a recorded failure
+    in this codebase, and the columns this reads (ID and Proof) are the
+    columns that file's contract already names.
+
+    The shipped template's UNFILLED marker is treated as no plan at all, the
+    same call sbe_design.check_behaviour makes over the same marker: the
+    example's rows are somebody else's design and certifying evidence against
+    them would be grading a fixture.
+    """
+    d = os.path.abspath(os.path.dirname(receipt_path))
+    stop = os.path.abspath(root)
+    while True:
+        problem = sbe_design.read_problem(d, BEHAVIOUR)
+        if problem:
+            return None, os.path.join(d, BEHAVIOUR), problem
+        text = sbe_design.read(d, BEHAVIOUR)
+        if text is not None:
+            if sbe_design._MARKER_COMMENT.search(text):
+                return None, os.path.join(d, BEHAVIOUR), ""
+            rows, malformed = sbe_design._behaviour_rows(text)
+            if malformed:
+                return None, os.path.join(d, BEHAVIOUR), (
+                    "%d row(s) under its ID | Starting point | Trigger | Required outcome | "
+                    "Proof table do not carry 5 cells" % len(malformed))
+            return rows, os.path.join(d, BEHAVIOUR), ""
+        if d == stop or os.path.dirname(d) == d:
+            return None, "", ""
+        d = os.path.dirname(d)
+
+
+def _owed(root, by_receipt):
+    """(fail sentences, unmatchable row count, planless sentences) for every
+    receipt graded against the plan that governs it.
+
+    THE DEFECT THIS CLOSES: this gate read the evidence and never the plan
+    that says which checks were owed, so a receipt carrying one check was
+    graded exactly as green as one carrying all of them.
+
+    Receipts sharing one plan are graded as a POOL, not one at a time: a
+    monorepo whose behaviour table sits at the root and whose packages each
+    carry their own receipt owes each row ONCE, and demanding every row of
+    every package's receipt would fail a tree where the plan is satisfied
+    between them. The nearest table wins for each receipt (see _plan_rows), so
+    a package with its own table is still graded against that one alone.
+    """
+    plans, fails, unmatchable, planless = {}, [], 0, []
+    for rel, path, names in by_receipt:
+        rows, source, problem = _plan_rows(root, path)
+        if problem:
+            fails.append("%s: %s is %s, and a plan that cannot be read is a broken claim, not "
+                         "an absent one" % (rel, os.path.relpath(source, root), problem))
+            continue
+        if rows is None:
+            planless.append("%s: no %s at or above it, so nothing here says which checks were "
+                            "owed" % (rel, BEHAVIOUR))
+            continue
+        if not rows:
+            planless.append("%s: %s holds no behaviour rows, so nothing there says which checks "
+                            "were owed" % (rel, os.path.relpath(source, root)))
+            continue
+        pool = plans.setdefault(source, {"names": [], "receipts": [], "rows": rows})
+        pool["names"].extend(str(n).lower() for n in names)
+        pool["receipts"].append(rel)
+    for source, pool in sorted(plans.items()):
+        lowered, covered = pool["names"], pool["receipts"]
+        for row in pool["rows"]:
+            proofs = _PROOF_CHECK.findall(row.get("proof") or "")
+            if not proofs:
+                unmatchable += 1
+                continue
+            missing = [p for p in proofs if not any(p.lower() in n for n in lowered)]
+            if missing:
+                fails.append("%s row %s: its Proof names %s, which no check in %s recorded"
+                             % (os.path.relpath(source, root), row.get("id") or "(no id)",
+                                ", ".join(missing[:3]), ", ".join(covered[:3])))
+    return fails, unmatchable, planless
+
