+import unittest
+
+from src.clamp import clamp
+
+
+class ClampTest(unittest.TestCase):
+    def test_value_inside_range_passes_through(self):
+        self.assertEqual(clamp(5, 0, 10), 5)
+
+    def test_value_below_low_returns_low(self):
+        self.assertEqual(clamp(-3, 0, 10), 0)
+
+    def test_value_above_high_returns_high(self):
+        self.assertEqual(clamp(42, 0, 10), 10)
+
+    def test_bounds_are_inclusive(self):
+        self.assertEqual(clamp(0, 0, 10), 0)
+        self.assertEqual(clamp(10, 0, 10), 10)
+
+    def test_low_equals_high(self):
+        self.assertEqual(clamp(7, 3, 3), 3)
+
+    def test_works_with_floats(self):
+        self.assertEqual(clamp(1.5, 0.0, 1.0), 1.0)
+
+    def test_negative_range(self):
+        self.assertEqual(clamp(-5, -10, -1), -5)
+        self.assertEqual(clamp(0, -10, -1), -1)
+
+    def test_low_greater_than_high_raises(self):
+        with self.assertRaises(ValueError):
+            clamp(5, 10, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
