+"""Bound a value into a closed range."""
+
+
+def clamp(value, low, high):
+    """Return ``value`` bounded into the closed range ``[low, high]``.
+
+    Raises:
+        ValueError: if ``low > high``.
+    """
+    if low > high:
+        raise ValueError("low must not be greater than high")
+    if value < low:
+        return low
+    if value > high:
+        return high
+    return value
