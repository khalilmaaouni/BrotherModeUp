@@ -0,0 +1,17 @@
+"""Turn a title into a URL-friendly slug."""
+
+import re
+
+_NOT_ALNUM = re.compile(r"[^a-z0-9]+")
+
+
+def slugify(title):
+    """Lowercase `title`, keep only letters and digits, join words with hyphens.
+
+    Runs of characters that are neither letters nor digits become a single
+    hyphen; leading and trailing hyphens are stripped.
+
+    >>> slugify("Hello, World!")
+    'hello-world'
+    """
+    return _NOT_ALNUM.sub("-", title.lower()).strip("-")
