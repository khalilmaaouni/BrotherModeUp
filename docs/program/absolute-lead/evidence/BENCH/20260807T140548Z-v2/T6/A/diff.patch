+import unittest
+
+from src.chunk import chunk
+
+
+class ChunkTest(unittest.TestCase):
+    def test_even_split(self):
+        self.assertEqual(list(chunk([1, 2, 3, 4], 2)), [[1, 2], [3, 4]])
+
+    def test_last_chunk_is_short(self):
+        self.assertEqual(list(chunk([1, 2, 3], 2)), [[1, 2], [3]])
+
+    def test_preserves_order(self):
+        self.assertEqual(list(chunk("abcde", 2)), [["a", "b"], ["c", "d"], ["e"]])
+
+    def test_size_larger_than_input(self):
+        self.assertEqual(list(chunk([1, 2], 10)), [[1, 2]])
+
+    def test_size_one(self):
+        self.assertEqual(list(chunk([1, 2, 3], 1)), [[1], [2], [3]])
+
+    def test_empty_input_yields_nothing(self):
+        self.assertEqual(list(chunk([], 3)), [])
+
+    def test_accepts_a_lazy_iterator(self):
+        self.assertEqual(list(chunk(iter(range(5)), 3)), [[0, 1, 2], [3, 4]])
+
+    def test_yields_lists(self):
+        for batch in chunk("ab", 1):
+            self.assertIsInstance(batch, list)
+
+    def test_size_zero_raises_eagerly(self):
+        with self.assertRaises(ValueError):
+            chunk([1, 2], 0)
+
+    def test_negative_size_raises_eagerly(self):
+        with self.assertRaises(ValueError):
+            chunk([1, 2], -1)
+
+
+if __name__ == "__main__":
+    unittest.main()
