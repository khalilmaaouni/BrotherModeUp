+"""Unit tests for :func:`src.dedupe.dedupe`."""
+
+import unittest
+
+from src.dedupe import dedupe
+
+
+class DedupeTest(unittest.TestCase):
+    def test_removes_later_duplicates(self):
+        self.assertEqual(dedupe([1, 2, 1, 3, 2]), [1, 2, 3])
+
+    def test_keeps_first_seen_order(self):
+        self.assertEqual(dedupe(["b", "a", "b", "c", "a"]), ["b", "a", "c"])
+
+    def test_list_without_duplicates_is_unchanged(self):
+        self.assertEqual(dedupe([1, 2, 3]), [1, 2, 3])
+
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(dedupe([]), [])
+
+    def test_all_elements_identical(self):
+        self.assertEqual(dedupe(["x", "x", "x"]), ["x"])
+
+    def test_returns_a_new_list(self):
+        items = [1, 2, 3]
+        result = dedupe(items)
+        self.assertEqual(result, items)
+        self.assertIsNot(result, items)
+
+    def test_does_not_mutate_its_argument(self):
+        items = [1, 1, 2]
+        dedupe(items)
+        self.assertEqual(items, [1, 1, 2])
+
+    def test_accepts_any_iterable(self):
+        self.assertEqual(dedupe(iter([1, 1, 2])), [1, 2])
+        self.assertEqual(dedupe("aabbc"), ["a", "b", "c"])
+
+    def test_mixed_types_are_compared_by_equality(self):
+        self.assertEqual(dedupe([1, "1", 1, "1"]), [1, "1"])
+
+    def test_none_is_treated_as_a_value(self):
+        self.assertEqual(dedupe([None, 1, None]), [None, 1])
+
+    def test_unhashable_elements_are_deduped(self):
+        self.assertEqual(dedupe([[1], [2], [1]]), [[1], [2]])
+
+    def test_unhashable_and_hashable_mixed(self):
+        self.assertEqual(dedupe([[1], 2, [1], 2, {"a": 1}]), [[1], 2, {"a": 1}])
+
+    def test_preserves_element_identity(self):
+        first = [1]
+        later_equal = [1]
+        result = dedupe([first, later_equal])
+        self.assertEqual(len(result), 1)
+        self.assertIs(result[0], first)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/src/test_is_palindrome.py b/src/test_is_palindrome.py
