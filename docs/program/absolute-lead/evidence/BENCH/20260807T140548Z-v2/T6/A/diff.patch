+"""Split an iterable into fixed-size chunks."""
+
+
+def chunk(items, size):
+    """Yield lists of at most `size` items from `items`, in order.
+
+    The final chunk may be shorter. Raises ValueError when `size` < 1 --
+    eagerly, at call time, rather than on first iteration.
+
+    >>> list(chunk([1, 2, 3], 2))
+    [[1, 2], [3]]
+    """
+    if size < 1:
+        raise ValueError("size must be at least 1, got %r" % (size,))
+    return _chunk(items, size)
+
+
+def _chunk(items, size):
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
