@@ -0,0 +1,20 @@
+"""Turn a title into a URL-friendly slug."""
+
+import re
+
+_NOT_ALLOWED = re.compile(r"[^a-z0-9]+")
+
+
+def slugify(title):
+    """Lowercase `title`, keep only letters and digits, join words with hyphens.
+
+    Any run of characters that is neither an ASCII letter nor a digit acts as a
+    word separator and collapses to a single hyphen. Leading and trailing
+    hyphens are stripped, so the result never starts or ends with one.
+
+    >>> slugify("  Hello, World!  ")
+    'hello-world'
+    """
+    if not isinstance(title, str):
+        raise TypeError("title must be a string")
+    return _NOT_ALLOWED.sub("-", title.lower()).strip("-")
