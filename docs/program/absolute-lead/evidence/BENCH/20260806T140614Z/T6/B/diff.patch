+"""Bound a value into a range."""
+
+
+def clamp(value, low, high):
+    """Return ``value`` bounded into ``[low, high]``.
+
+    Values below ``low`` come back as ``low``, values above ``high`` come
+    back as ``high``, and anything in between is returned unchanged.
+
+    Raises ``ValueError`` when ``low > high``, because that range is empty
+    and no answer would be honest.
+    """
+    if low > high:
+        raise ValueError("low (%r) must not be greater than high (%r)" % (low, high))
+    if value < low:
+        return low
+    if value > high:
+        return high
+    return value
