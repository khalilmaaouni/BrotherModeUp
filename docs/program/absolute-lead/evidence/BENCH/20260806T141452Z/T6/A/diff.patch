+"""Turn a title into a URL-friendly slug."""
+
+
+def slugify(title):
+    """Lowercase ``title``, keep letters and digits, join words with hyphens.
+
+    Every run of characters that is not a letter or a digit acts as a word
+    separator, so leading, trailing and repeated separators collapse into a
+    single hyphen (or vanish at the edges).
+
+    >>> slugify("  Hello, World!  ")
+    'hello-world'
+    """
+    words = []
+    current = []
+    for char in title:
+        if char.isalnum():
+            current.append(char.lower())
+        elif current:
+            words.append("".join(current))
+            current = []
+    if current:
+        words.append("".join(current))
+    return "-".join(words)
