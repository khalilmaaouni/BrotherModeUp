@@ -0,0 +1,20 @@
+"""Turn a title into a URL-friendly slug."""
+
+import re
+
+_WORDS = re.compile(r"[a-z0-9]+")
+
+
+def slugify(title):
+    """Lowercase ``title``, keep only letters and digits, join words with hyphens.
+
+    Any run of characters that is not a letter or a digit acts as a word
+    separator, so the result never contains leading, trailing, or repeated
+    hyphens.
+
+    Raises:
+        TypeError: if ``title`` is not a string.
+    """
+    if not isinstance(title, str):
+        raise TypeError("title must be a string, got %s" % type(title).__name__)
+    return "-".join(_WORDS.findall(title.lower()))
