@@ -0,0 +1,15 @@
+"""clamp(value, low, high) -> value bounded into [low, high]."""
+
+
+def clamp(value, low, high):
+    """Return `value` bounded into the closed interval [low, high].
+
+    Raises ValueError if low > high.
+    """
+    if low > high:
+        raise ValueError("low (%r) must not be greater than high (%r)" % (low, high))
+    if value < low:
+        return low
+    if value > high:
+        return high
+    return value
