+"""Split a sequence of items into fixed-size batches."""
+
+
+def chunk(items, size):
+    """Yield lists of at most ``size`` items from ``items``, in order.
+
+    The final list is short when the items do not divide evenly. Any iterable
+    works, including a generator; nothing is read until the caller asks for the
+    first batch.
+
+    Raises:
+        ValueError: if ``size`` is less than 1.
+    """
+    if size < 1:
+        raise ValueError("size must be at least 1")
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
