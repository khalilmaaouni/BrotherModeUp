+"""Split an iterable into fixed-size batches."""
+
+
+def chunk(items, size):
+    """Yield lists of at most ``size`` items from ``items``, in order.
+
+    Raises ValueError when ``size`` is less than 1. The check happens eagerly,
+    when ``chunk`` is called, not when the result is first iterated.
+
+    >>> list(chunk([1, 2, 3], 2))
+    [[1, 2], [3]]
+    """
+    if size < 1:
+        raise ValueError("size must be at least 1, got %r" % (size,))
+    return _chunk(items, size)
+
+
+def _chunk(items, size):
+    batch = []
+    for item in items:
+        batch.append(item)
+        if len(batch) == size:
+            yield batch
+            batch = []
+    if batch:
+        yield batch
